# ============================================================
#  Copy file này thành `.env` rồi điền key vào. Không bắt buộc
#  phải có key ngay — phần mềm vẫn chạy được ở chế độ offline.
# ============================================================

# --- 1. Claude (Anthropic) — dùng để HIỂU NGỮ CẢNH ---------
# Bật: phát hiện câu vấp/nói lại, đoạn lạc đề, và chọn B-roll đúng ngữ cảnh.
# Tắt (để trống): vẫn cắt được im lặng + từ đệm + vấp (bằng thuật toán so trùng).
# Lấy key: https://console.anthropic.com  -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Model dùng để phân tích. Để mặc định là tốt nhất.
ANALYSIS_MODEL=claude-opus-5

# --- 2. Pexels — kho video stock miễn phí -------------------
# Lấy key miễn phí trong 1 phút: https://www.pexels.com/api/new/
PEXELS_API_KEY=

# --- 3. Pixabay — kho video stock miễn phí (dự phòng) -------
# Lấy key miễn phí: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ============================================================
#  TẠO VIDEO NGƯỜI NÓI TỪ ẢNH  (trang "🎬 Tạo video")
# ============================================================

# --- 4. Google Gemini — BẮT BUỘC cho phần tạo video ---------
# Dùng để: biên tập kịch bản, đọc lời thoại thành tiếng (TTS),
# và chạy Veo nếu bạn chọn engine đó.
# Lấy key miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Các model. Để mặc định là hợp lý.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VEO_MODEL=veo-3.1-generate-preview

# --- 5. Engine nhép môi -------------------------------------
# auto       : tự chọn cái tốt nhất đã cài (khuyên dùng)
# latentsync : nét nhất, cần GPU >= 8GB   -> bash setup_lipsync.sh latentsync
# sadtalker  : có cử động đầu, nhẹ hơn    -> bash setup_lipsync.sh sadtalker
# wav2lip    : nhẹ nhất, chạy máy yếu     -> bash setup_lipsync.sh wav2lip
# veo        : không cần cài, nhưng Veo TỰ ĐỌC lời thoại bằng giọng của nó
#              và mỗi câu chỉ ra được ~8 giây
# still      : không nhép môi, chỉ zoom chậm ảnh tĩnh
LIPSYNC_ENGINE=auto

# Nơi chứa các repo lip-sync đã tải (setup_lipsync.sh tự tạo)
# LIPSYNC_HOME=./vendor

# Python dùng để chạy repo lip-sync. Để trống = dùng chung .venv hiện tại.
# Nếu repo đó cần môi trường riêng thì trỏ thẳng vào đây.
# LIPSYNC_PYTHON=/duong/dan/toi/venv-latentsync/bin/python

# Thời gian tối đa cho một lần nhép môi (giây). Video dài thì tăng lên.
LIPSYNC_TIMEOUT=1800

# Thư mục nhạc nền. Cứ thả file .mp3 vào đây là dùng được.
# MUSIC_DIR=./data/music

# ============================================================
#  Cấu hình máy (có thể để nguyên)
# ============================================================

# Model Whisper: tiny | base | small | medium | large-v3
# Bạn có GPU NVIDIA -> để large-v3 cho chính xác nhất.
WHISPER_MODEL=large-v3

# auto | cuda | cpu
WHISPER_DEVICE=auto

# float16 (GPU) | int8 (CPU) | auto
WHISPER_COMPUTE_TYPE=auto

# Tăng tốc render bằng card NVIDIA (h264_nvenc). Đặt 0 nếu render lỗi.
USE_NVENC=1

# Cổng chạy web
PORT=8000
