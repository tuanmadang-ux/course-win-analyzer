# ============================================================
#  Copy file này thành `.env` rồi điền key vào. Không bắt buộc
#  phải có key ngay — phần mềm vẫn chạy được ở chế độ offline.
# ============================================================

# --- 1. Claude (Anthropic) — dùng để HIỂU NGỮ CẢNH ---------
# Bật: phát hiện câu vấp/nói lại, đoạn lạc đề, và chọn B-roll đúng ngữ cảnh.
# Tắt (để trống): vẫn cắt được im lặng + từ đệm + vấp (bằng thuật toán so trùng).
# Lấy key: https://console.anthropic.com  -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Model dùng để phân tích. Để mặc định là tốt nhất.
ANALYSIS_MODEL=claude-opus-5

# --- 2. Pexels — kho video stock miễn phí -------------------
# Lấy key miễn phí trong 1 phút: https://www.pexels.com/api/new/
PEXELS_API_KEY=

# --- 3. Pixabay — kho video stock miễn phí (dự phòng) -------
# Lấy key miễn phí: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ============================================================
#  Cấu hình máy (có thể để nguyên)
# ============================================================

# Model Whisper: tiny | base | small | medium | large-v3
# Bạn có GPU NVIDIA -> để large-v3 cho chính xác nhất.
WHISPER_MODEL=large-v3

# auto | cuda | cpu
WHISPER_DEVICE=auto

# float16 (GPU) | int8 (CPU) | auto
WHISPER_COMPUTE_TYPE=auto

# Tăng tốc render bằng card NVIDIA (h264_nvenc). Đặt 0 nếu render lỗi.
USE_NVENC=1

# Cổng chạy web
PORT=8000

# ============================================================
#  RADAR ĐỐI THỦ (python run_radar.py) — tất cả đều tuỳ chọn
#  Không điền gì vẫn chạy được: dán bài + bình luận bằng tay,
#  đào insight, viết bài, rồi copy đăng tay.
# ============================================================

RADAR_PORT=8010

# Model dùng để đào insight và viết bài (mặc định lấy theo ANALYSIS_MODEL)
WRITER_MODEL=claude-opus-5

# --- Giọng điệu Fanpage của bạn (AI viết theo) --------------
BRAND_NAME=
BRAND_VOICE=
BRAND_CTA=

# --- Thu thập tự động qua Apify (tuỳ chọn) ------------------
# Bạn tự đăng ký tài khoản Apify và chọn actor. Phần mềm chỉ gọi API
# công khai của Apify bằng token của bạn — không tự đăng nhập Facebook.
# Hạn mức, chi phí và việc tuân thủ điều khoản nền tảng thuộc về tài
# khoản Apify của bạn.
APIFY_TOKEN=
APIFY_ACTOR_POSTS=
APIFY_ACTOR_COMMENTS=

# Mỗi actor có schema đầu vào riêng. Sửa lại nếu actor bạn chọn dùng tên
# trường khác. `{target}` và `{limit}` được thay lúc chạy.
# APIFY_POSTS_INPUT={"startUrls":[{"url":"{target}"}],"resultsLimit":{limit}}
# APIFY_COMMENTS_INPUT={"startUrls":[{"url":"{target}"}],"resultsLimit":{limit}}

# --- Fanpage CỦA BẠN: đăng bài + đọc chỉ số (tuỳ chọn) ------
# Lấy Page Access Token ở https://developers.facebook.com
# Chỉ dùng cho trang bạn quản trị. Không dùng để đọc trang người khác.
FB_PAGE_ID=
FB_PAGE_TOKEN=
GRAPH_VERSION=v21.0

# Múi giờ để tính khung giờ vàng (Việt Nam = 7)
TZ_OFFSET_HOURS=7

# --- Ra lệnh qua Telegram (python run_bot.py) ---------------
# Lấy token trong 1 phút: mở Telegram, nhắn @BotFather, gõ /newbot
TELEGRAM_BOT_TOKEN=

# Để trống thì người bấm /start ĐẦU TIÊN thành chủ bot và khoá luôn từ đó
# (ghi vào data/radar/telegram_owner.json — muốn đổi chủ thì xoá file đó).
# Muốn chỉ định sẵn thì điền id, cách nhau bằng dấu phẩy.
TELEGRAM_ALLOWED_IDS=
